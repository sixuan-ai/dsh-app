# dsh app 公网入口 nginx 样例 —— 放在公网服务器 /etc/nginx/conf.d/dsh.conf
# 把 dsh.example.com 全部替换成你的域名后,certbot 申请证书即可。
#
# 链路: 手机 App → (可选 Cloudflare) → 本机 nginx :443
#        → frp tcp 隧道 127.0.0.1:9980 → 家里/办公室的 dsh 电脑

upstream dsh_web_backend {
    server 127.0.0.1:9980; # frpc 隧道在这台服务器上的 remote_port
    keepalive 32;
}

server {
    listen 80;
    server_name dsh.example.com;

    # Let's Encrypt HTTP-01 验证
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name dsh.example.com;

    ssl_certificate     /etc/letsencrypt/live/dsh.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dsh.example.com/privkey.pem;

    client_max_body_size 200m;

    # 产品官网(公开静态站点)
    location = /app {
        return 301 /app/;
    }
    location /app/ {
        alias /var/www/dsh-site/;
        index index.html;
    }

    # 官网公开下载(仅 latest APK 与版本信息)
    location /app/dl/ {
        alias /var/www/dsh-releases-public/;
        add_header Cache-Control "no-store";
        types { }
        default_type application/vnd.android.package-archive;
    }

    # Social backend for the mobile app (friends/community/messages).
    location /social/ {
        proxy_pass http://127.0.0.1:9981;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        auth_basic "dsh social";
        auth_basic_user_file /etc/nginx/.htpasswd-dsh;
    }

    # OTA releases for the mobile app (Basic-auth protected static dir).
    location /releases/ {
        alias /var/www/dsh-releases/;
        auth_basic "dsh releases";
        auth_basic_user_file /etc/nginx/.htpasswd-dsh;
        autoindex off;
        add_header Cache-Control "no-store";
    }

    location / {
        proxy_pass http://dsh_web_backend;
        proxy_http_version 1.1;

        # WebSocket 升级头(/api/events.mux 与 /api/events.host 是长连 WS)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # 流式会话可能长时间没有字节,超时必须拉长
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
