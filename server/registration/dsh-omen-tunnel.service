[Unit]
Description=Encrypted DSH OMEN tunnel to account gateway
After=network-online.target

[Service]
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -i /home/x/.ssh/id_ed25519 -R 127.0.0.1:9982:127.0.0.1:3081 root@47.239.235.154
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
